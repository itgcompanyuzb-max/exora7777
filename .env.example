# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Google Sign-In.
# Get this from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
VITE_GOOGLE_CLIENT_ID=""

# RESEND_API_KEY: Resend API Key for sending real transactional emails (verification codes, OTPs).
RESEND_API_KEY=""

# Gmail SMTP (100% Free, NO Domain Required, sends to any email address)
# Get a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# TELEGRAM_GATEWAY_TOKEN: Official Telegram Gateway API Token (https://gateway.telegram.org)
# Sends verification codes directly to Telegram users via the official @VerificationCodes bot
TELEGRAM_GATEWAY_TOKEN=""

# Broker Adapter API Endpoints (MetaTrader / REST WS Broker)
VITE_BROKER_URL="https://api.broker-demo.com/v1"
VITE_BROKER_KEY="demo_key_777"
VITE_BROKER_WS_URL="wss://stream.broker-demo.com/ticks"

# ---- Trading backend ----
# Required in production: long random string used to sign session tokens.
JWT_SECRET=""
# Super admin bootstrap (created on first start if no super admin exists).
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD=""
# SQLite file (default ./data/exora.db). Use a persistent volume in production.
DB_PATH=""
# Price feed: auto (default, REAL prices) | simulated (random walk, demo only)
#   crypto  -> Binance (no key)
#   forex / gold / silver / oil / US30 -> Yahoo Finance polling (no key, near real-time, unofficial)
#   optional streaming upgrade for those -> Finnhub (free key at finnhub.io)
MARKET_FEED="auto"
FINNHUB_API_KEY=""
# Test mode (default on): virtual money only, real deposits/withdrawals are refused.
TEST_MODE="on"
# Risk: margin call / stop out levels in percent; MARKET_HOURS=off disables weekend lock (dev).
MARGIN_CALL_LEVEL=100
STOP_OUT_LEVEL=20
MARKET_HOURS="on"
